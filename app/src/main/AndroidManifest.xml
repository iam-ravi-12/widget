<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:name=".WidgetApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartWidgets">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartWidgets">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.screens.weather.WeatherConfigurationActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartWidgets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widgets.clock.ClockWidgetReceiver"
            android:exported="true"
            android:label="@string/clock_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.battery.BatteryWidgetReceiver"
            android:exported="true"
            android:label="@string/battery_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_info" />
        </receiver>

        <service
            android:name=".widgets.battery.BatteryMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuously monitor battery state so placed battery widgets can update when the battery changes" />
        </service>

        <receiver
            android:name=".widgets.calendar.CalendarWidgetReceiver"
            android:exported="true"
            android:label="@string/calendar_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data android:scheme="content" android:host="com.android.calendar" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.notes.QuickNotesWidgetReceiver"
            android:exported="true"
            android:label="@string/quick_notes_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_notes_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.weather.WeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/weather_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.storage.StorageWidgetReceiver"
            android:exported="true"
            android:label="@string/storage_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/storage_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.memory.MemoryWidgetReceiver"
            android:exported="true"
            android:label="@string/memory_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/memory_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.network.NetworkWidgetReceiver"
            android:exported="true"
            android:label="@string/network_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/network_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.deviceinfo.DeviceInfoWidgetReceiver"
            android:exported="true"
            android:label="@string/deviceinfo_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deviceinfo_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.worldclock.WorldClockWidgetReceiver"
            android:exported="true"
            android:label="@string/worldclock_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/worldclock_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.countdown.CountdownWidgetReceiver"
            android:exported="true"
            android:label="@string/countdown_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.pomodoro.PomodoroWidgetReceiver"
            android:exported="true"
            android:label="@string/pomodoro_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.widget.smartwidgets.POMODORO_SESSION_COMPLETE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pomodoro_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.todo.TodoWidgetReceiver"
            android:exported="true"
            android:label="@string/todo_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.photoframe.PhotoFrameWidgetReceiver"
            android:exported="true"
            android:label="@string/photoframe_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/photoframe_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.quote.QuoteWidgetReceiver"
            android:exported="true"
            android:label="@string/quote_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quote_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.battery.BatteryBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Month Calendar -->
        <receiver android:name=".widgets.calendar.MonthCalendarWidgetReceiver" android:exported="true" android:label="Month Calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/month_calendar_widget_info" />
        </receiver>

        <!-- Today Date -->
        <receiver android:name=".widgets.calendar.TodayDateWidgetReceiver" android:exported="true" android:label="Today Date">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_date_widget_info" />
        </receiver>

        <!-- Analog Clock A -->
        <receiver android:name=".widgets.clock.AnalogClockAWidgetReceiver" android:exported="true" android:label="Analog Clock A">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/analog_clock_a_widget_info" />
        </receiver>

        <!-- Analog Clock B -->
        <receiver android:name=".widgets.clock.AnalogClockBWidgetReceiver" android:exported="true" android:label="Analog Clock B">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/analog_clock_b_widget_info" />
        </receiver>

        <!-- Analog Clock C -->
        <receiver android:name=".widgets.clock.AnalogClockCWidgetReceiver" android:exported="true" android:label="Analog Clock C">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/analog_clock_c_widget_info" />
        </receiver>

        <!-- Steps -->
        <receiver android:name=".widgets.health.StepsWidgetReceiver" android:exported="true" android:label="Steps">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/steps_widget_info" />
        </receiver>

        <!-- Screen Time -->
        <receiver android:name=".widgets.health.ScreenTimeWidgetReceiver" android:exported="true" android:label="Screen Time">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/screen_time_widget_info" />
        </receiver>

        <!-- Airplane Mode -->
        <receiver android:name=".widgets.status.AirplaneModeWidgetReceiver" android:exported="true" android:label="Airplane Mode">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.AIRPLANE_MODE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/airplane_mode_widget_info" />
        </receiver>

        <!-- Auto Rotation -->
        <receiver android:name=".widgets.status.AutoRotationWidgetReceiver" android:exported="true" android:label="Auto Rotation">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/auto_rotation_widget_info" />
        </receiver>

        <!-- Internet -->
        <receiver android:name=".widgets.status.InternetWidgetReceiver" android:exported="true" android:label="Internet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/internet_widget_info" />
        </receiver>

        <!-- Location -->
        <receiver android:name=".widgets.status.LocationWidgetReceiver" android:exported="true" android:label="Location">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.location.PROVIDERS_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/location_widget_info" />
        </receiver>

        <!-- Do Not Disturb -->
        <receiver android:name=".widgets.status.DoNotDisturbWidgetReceiver" android:exported="true" android:label="Do Not Disturb">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.app.action.INTERRUPTION_FILTER_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/dnd_widget_info" />
        </receiver>

        <!-- Hotspot -->
        <receiver android:name=".widgets.status.HotspotWidgetReceiver" android:exported="true" android:label="Hotspot">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.net.wifi.WIFI_AP_STATE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hotspot_widget_info" />
        </receiver>

        <!-- Torch -->
        <receiver android:name=".widgets.status.TorchWidgetReceiver" android:exported="true" android:label="Torch">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/torch_widget_info" />
        </receiver>

        <service
            android:name=".widgets.status.StatusWidgetsMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuously monitors system status so placed widgets can update instantly" />
        </service>

    </application>

</manifest>
